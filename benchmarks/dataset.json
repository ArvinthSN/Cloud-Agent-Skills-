        "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----",
        "password\\s*[:=]\\s*(?:['\\\"][^'\\\"]{6,}['\\\"]|[^\\s'\\\"]{6,})",
        "terraform\\s+(apply|destroy)"
      ],
      "warning_patterns": [
        ":latest\\b",
        "curl\\s+[^|]+\\|\\s*(sudo\\s+)?(sh|bash)"
      ]
    }
  },

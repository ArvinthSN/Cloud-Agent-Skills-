{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArvinthSN/Cloud-Agent-Skills-/schemas/execution-state.schema.json",
  "title": "Cloud Agent Skills execution journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_hash",
    "status",
    "attempt",
    "created_at",
    "updated_at",
    "overwrite_approved",
    "execution_order",
    "completed_skills",
    "current_skill",
    "transaction",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "interrupted",
        "failed",
        "completed"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overwrite_approved": {
      "type": "boolean"
    },
    "execution_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "app-containerizer",
          "cicd-pipeline-creator",
          "infra-creator"
        ]
      }
    },
    "completed_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "app-containerizer",
          "cicd-pipeline-creator",
          "infra-creator"
        ]
      }
    },
    "current_skill": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "app-containerizer",
        "cicd-pipeline-creator",
        "infra-creator",
        null
      ]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "backup_dir",
        "snapshots",
        "created_directories"
      ],
      "properties": {
        "phase": {
          "enum": [
            "idle",
            "preparing",
            "prepared",
            "running",
            "committing",
            "rolling_back",
            "rolled_back",
            "committed"
          ]
        },
        "backup_dir": {
          "type": "string"
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "backup",
              "kind"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "backup": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "missing",
                  "file",
                  "directory"
                ]
              }
            }
          }
        },
        "created_directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "event"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}

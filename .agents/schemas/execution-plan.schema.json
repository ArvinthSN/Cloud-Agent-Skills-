{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArvinthSN/Cloud-Agent-Skills-/schemas/execution-plan.schema.json",
  "title": "Cloud Agent Skills execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request", "project", "selected_skills", "approval_required"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] },
        "detected_stack": { "type": "array", "items": { "type": "string" } },
        "architecture": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "selected_skills": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "approval_required": { "type": "boolean" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "blocked_on": { "type": "array", "items": { "type": "string" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArvinthSN/Cloud-Agent-Skills-/schemas/architecture-profile.schema.json",
  "title": "Cloud Agent Skills architecture profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_root", "snapshot_hash", "architecture", "confidence", "project_count", "components", "signals", "uncertainties"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_root": {"type": "string", "minLength": 1},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "architecture": {"enum": ["monolith", "frontend_backend", "microservices", "multi_project", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "project_count": {"type": "integer", "minimum": 0},
    "components": {
      "type": "array", "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "technology", "project_dir", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["frontend", "backend", "worker", "data_store", "unknown"]},
          "technology": {"type": "string", "minLength": 1},
          "project_dir": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "maxItems": 6, "items": {"type": "string"}}
        }
      }
    },
    "signals": {"type": "array", "maxItems": 30, "items": {"type": "string"}},
    "uncertainties": {"type": "array", "maxItems": 20, "items": {"type": "string"}}
  }
}
